---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

const assetImages = import.meta.glob('../assets/*.{jpg,png}', {
	eager: true,
	query: '?url',
	import: 'default',
});

function findAssetUrl(path: string) {
	const fileName = path.split('/').pop();
	return Object.entries(assetImages).find((entry) => entry[0].endsWith(fileName ?? ''))?.[1] ?? null;
}

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const heroImageSrc = typeof heroImage === 'string' ? findAssetUrl(heroImage) : heroImage;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Vinayak's Blog`} description={description} />
	</head>
	<body>
		<Header />
		<main class="post-page">
			<article>
				<header class="article-header">
					<nav class="breadcrumb" aria-label="Breadcrumb">
						<a href={`${basePath}/blog`}>Blog</a>
						<span aria-hidden="true">/</span>
						<span>Article</span>
					</nav>
					<p class="eyebrow">Article</p>
					<div class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated-date">
								Updated <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1>{title}</h1>
					<p class="description">{description}</p>
				</header>

				{heroImageSrc && (
					<figure class="hero-image">
						<Image width={1200} height={600} src={heroImageSrc} alt={title} />
					</figure>
				)}

				<div class="article-body">
					<slot />
					<div class="post-footer">
						<a href={`${basePath}/blog`}>← Back to all articles</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-page {
		box-sizing: border-box;
		width: 100%;
		max-width: none;
		margin: 0;
		padding: clamp(2.5rem, 6vw, 4.5rem) 1rem 5rem;
	}

	.article-header {
		max-width: 780px;
		margin: 0 auto;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 2rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}

	.breadcrumb a {
		color: var(--accent);
		font-weight: 700;
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--accent-dark);
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.date {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}

	.updated-date {
		padding-left: 0.75rem;
		border-left: 1px solid rgb(var(--gray-light));
	}

	.article-header h1 {
		margin-bottom: 1rem;
		font-size: clamp(2.2rem, 5vw, 3.8rem);
		letter-spacing: -0.045em;
		line-height: 1.12;
	}

	.description {
		max-width: 68ch;
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.65;
	}

	.hero-image {
		max-width: 1060px;
		margin: 2.5rem auto;
	}

	.hero-image img {
		display: block;
		width: 100%;
		max-height: 440px;
		object-fit: cover;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 1rem;
	}

	.article-body {
		max-width: 760px;
		margin: 2.5rem auto 0;
		color: rgb(var(--gray-dark));
	}

	.article-body :global(p) {
		margin: 0 0 1.25rem;
		font-size: 1rem;
		line-height: 1.8;
	}

	.article-body :global(h2) {
		margin: 2.75rem 0 0.9rem;
		font-size: clamp(1.6rem, 3vw, 2rem);
		letter-spacing: -0.025em;
		line-height: 1.25;
	}

	.article-body :global(h3) {
		margin: 2rem 0 0.75rem;
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		line-height: 1.3;
	}

	.article-body :global(ul),
	.article-body :global(ol) {
		margin: 0 0 1.5rem;
		padding-left: 1.5rem;
	}

	.article-body :global(li) {
		margin-bottom: 0.55rem;
		padding-left: 0.2rem;
		line-height: 1.7;
	}

	.article-body :global(a) {
		font-weight: 600;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	.article-body :global(blockquote) {
		margin: 1.75rem 0;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--accent);
		border-radius: 0 0.5rem 0.5rem 0;
		background: rgb(255 255 255 / 75%);
		font-size: 1rem;
	}

	.article-body :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.article-body :global(pre) {
		overflow-x: auto;
		margin: 1.5rem 0;
		padding: 1.25rem;
		border: 1px solid rgb(255 255 255 / 10%);
		border-radius: 0.75rem;
		background: #111827;
		color: #f8fafc;
		font-size: 0.85rem;
		line-height: 1.65;
	}

	.article-body :global(pre code) {
		padding: 0;
		background: transparent;
		color: inherit;
	}

	.article-body :global(table) {
		display: block;
		overflow-x: auto;
		width: 100%;
		margin: 1.5rem 0;
		border-collapse: collapse;
		font-size: 0.9rem;
	}

	.article-body :global(th),
	.article-body :global(td) {
		padding: 0.75rem;
		border: 1px solid rgb(var(--gray-light));
		text-align: left;
		vertical-align: top;
	}

	.article-body :global(th) {
		background: rgb(255 255 255 / 75%);
		color: rgb(var(--black));
	}

	.article-body :global(img) {
		display: block;
		margin: 1.5rem auto;
		border-radius: 0.75rem;
	}

	.article-body :global(hr) {
		margin: 2rem 0;
	}

	.post-footer {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.post-footer a {
		color: var(--accent);
		font-size: 0.9rem;
		text-decoration: none;
	}

	@media (max-width: 600px) {
		.post-page {
			padding-inline: 1rem;
		}

		.article-header h1 {
			font-size: clamp(2rem, 10vw, 3rem);
		}

		.hero-image {
			margin: 1.75rem 0;
		}

		.article-body {
			margin-top: 2rem;
		}
	}
</style>
