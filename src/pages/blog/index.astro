---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { BLOG_TOPICS, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const topics = BLOG_TOPICS.map((topic) => ({
	...topic,
	posts: posts.filter((post) => topic.postIds.includes(post.id)),
})).filter((topic) => topic.posts.length > 0);

const categorizedPostIds = new Set(BLOG_TOPICS.flatMap((topic) => topic.postIds));
const uncategorizedPosts = posts.filter((post) => !categorizedPostIds.has(post.id));
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="blog-page">
			<header class="page-intro">
				<p class="eyebrow">The blog</p>
				<h1>Ideas from building real systems.</h1>
				<p>
					Notes on enterprise platforms, backend engineering, cloud architecture, and putting AI to work
					in complex business workflows.
				</p>
			</header>

			<nav class="topic-nav" aria-label="Browse articles by topic">
				<a href="#articles">All articles <span>{posts.length}</span></a>
				{topics.map((topic) => (
					<a href={`#topic-${topic.id}`}>
						{topic.title} <span>{topic.posts.length}</span>
					</a>
				))}
				{uncategorizedPosts.length > 0 && (
					<a href="#topic-other">Other <span>{uncategorizedPosts.length}</span></a>
				)}
			</nav>

			<section class="archive-section" id="articles" aria-labelledby="archive-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Browse the archive</p>
						<h2 id="archive-title">All articles</h2>
					</div>
					<p>{posts.length} articles</p>
				</div>

				{topics.map((topic) => (
					<section class="topic-section" id={`topic-${topic.id}`} aria-labelledby={`heading-${topic.id}`}>
						<div class="topic-heading">
							<div>
								<p class="eyebrow">Topic</p>
								<h3 id={`heading-${topic.id}`}>{topic.title}</h3>
								<p>{topic.description}</p>
							</div>
							<span class="topic-count">{topic.posts.length} articles</span>
						</div>
						<div class="article-grid">
							{topic.posts.map((post) => (
								<a class="article-card" href={`${basePath}/blog/${post.id}/`}>
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									<h4>{post.data.title}</h4>
									<p class="description">{post.data.description}</p>
									<span class="read-link">Read article <span aria-hidden="true">→</span></span>
								</a>
							))}
						</div>
					</section>
				))}

				{uncategorizedPosts.length > 0 && (
					<section class="topic-section" id="topic-other" aria-labelledby="heading-other">
						<div class="topic-heading">
							<div>
								<p class="eyebrow">Topic</p>
								<h3 id="heading-other">Other articles</h3>
							</div>
							<span class="topic-count">{uncategorizedPosts.length} articles</span>
						</div>
						<div class="article-grid">
							{uncategorizedPosts.map((post) => (
								<a class="article-card" href={`${basePath}/blog/${post.id}/`}>
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									<h4>{post.data.title}</h4>
									<p class="description">{post.data.description}</p>
									<span class="read-link">Read article <span aria-hidden="true">→</span></span>
								</a>
							))}
						</div>
					</section>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-page {
		width: min(100% - 2rem, 1060px);
		max-width: none;
		margin-inline: auto;
		padding: clamp(2.5rem, 6vw, 5rem) 0;
	}

	.page-intro {
		max-width: 760px;
		padding-bottom: 2rem;
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.page-intro h1 {
		max-width: 18ch;
		margin-bottom: 0.9rem;
		font-size: clamp(2.5rem, 5.5vw, 4rem);
		letter-spacing: -0.045em;
	}

	.page-intro > p:last-child {
		max-width: 62ch;
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		line-height: 1.6;
	}

	.topic-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding: 1.25rem 0 2.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.topic-nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.8rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: #fff;
		color: rgb(var(--gray-dark));
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		transition: border-color 160ms ease, color 160ms ease;
	}

	.topic-nav a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.topic-nav span {
		color: rgb(var(--gray));
		font-size: 0.75rem;
	}

	.archive-section {
		padding-top: 2.5rem;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.8rem, 3.6vw, 2.5rem);
		letter-spacing: -0.03em;
	}

	.section-heading > p,
	.topic-count {
		margin: 0 0 0.2rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}

	.topic-section {
		padding-top: 2.5rem;
		scroll-margin-top: 1rem;
	}

	.topic-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.topic-heading h3 {
		margin: 0 0 0.35rem;
		font-size: clamp(1.5rem, 3vw, 2rem);
		letter-spacing: -0.025em;
	}

	.topic-heading div > p:last-child {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.article-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-height: 100%;
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.8rem;
		background: #fff;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
	}

	.article-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		box-shadow: 0 10px 28px rgb(var(--black) / 8%);
		color: rgb(var(--gray-dark));
	}

	.article-card .date {
		margin: 0 0 0.75rem;
		color: rgb(var(--gray));
		font-size: 0.8rem;
	}

	.article-card h4 {
		margin: 0 0 0.75rem;
		color: rgb(var(--black));
		font-size: 1.1rem;
		line-height: 1.4;
	}

	.article-card .description {
		margin: 0 0 1.25rem;
		font-size: 0.9rem;
		line-height: 1.65;
	}

	.read-link {
		margin-top: auto;
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.article-card:hover .read-link {
		color: var(--accent-dark);
	}

	@media (max-width: 900px) {
		.article-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.blog-page {
			width: min(100% - 1.5rem, 1060px);
		}

		.article-grid {
			grid-template-columns: 1fr;
		}

		.section-heading,
		.topic-heading {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.article-card,
		.topic-nav a {
			transition: none;
		}
	}
</style>
