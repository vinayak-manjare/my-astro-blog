---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const today = new Date();
const posts = (await getCollection('blog'))
	.filter((post) => post.data.pubDate <= today)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const archivePosts = posts.slice(1);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="blog-page">
			<header class="page-intro">
				<p class="eyebrow">The blog</p>
				<h1>Ideas from building real systems.</h1>
				<p>
					Notes on enterprise platforms, backend engineering, cloud architecture, and putting AI to work
					in complex business workflows.
				</p>
			</header>

			{featuredPost ? (
				<section class="featured-section" aria-labelledby="featured-title">
					<p class="eyebrow">Latest article</p>
					<a class="featured-card" href={`${basePath}/blog/${featuredPost.id}/`}>
						<div class="featured-copy">
							<p class="date"><FormattedDate date={featuredPost.data.pubDate} /></p>
							<h2 id="featured-title">{featuredPost.data.title}</h2>
							<p class="description">{featuredPost.data.description}</p>
							<span class="read-link">Read article <span aria-hidden="true">→</span></span>
						</div>
						<span class="featured-mark" aria-hidden="true">01</span>
					</a>
				</section>
			) : (
				<p>No articles are published yet. Check back soon.</p>
			)}

			{archivePosts.length > 0 && (
				<section class="archive-section" aria-labelledby="archive-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow">Browse the archive</p>
							<h2 id="archive-title">More articles</h2>
						</div>
						<p>{archivePosts.length} articles</p>
					</div>
					<div class="article-grid">
						{archivePosts.map((post) => (
							<a class="article-card" href={`${basePath}/blog/${post.id}/`}>
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								<h3>{post.data.title}</h3>
								<p class="description">{post.data.description}</p>
								<span class="read-link">Read article <span aria-hidden="true">→</span></span>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-page {
		width: min(100% - 2rem, 1060px);
		max-width: none;
		margin-inline: auto;
		padding: clamp(2.5rem, 6vw, 5rem) 0;
	}

	.page-intro {
		max-width: 760px;
		padding-bottom: clamp(2.5rem, 6vw, 4rem);
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.page-intro h1 {
		max-width: 18ch;
		margin-bottom: 0.9rem;
		font-size: clamp(2.5rem, 5.5vw, 4rem);
		letter-spacing: -0.045em;
	}

	.page-intro > p:last-child {
		max-width: 62ch;
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		line-height: 1.6;
	}

	.featured-section {
		padding: clamp(2rem, 4vw, 3rem);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 1rem;
		background: rgb(255 255 255 / 82%);
		box-shadow: 0 12px 36px rgb(var(--black) / 6%);
	}

	.featured-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}

	.featured-card:hover {
		color: rgb(var(--gray-dark));
	}

	.featured-copy {
		max-width: 740px;
	}

	.featured-card .date,
	.article-card .date {
		margin: 0 0 0.75rem;
		color: rgb(var(--gray));
		font-size: 0.8rem;
	}

	.featured-card h2 {
		margin-bottom: 0.75rem;
		color: rgb(var(--black));
		font-size: clamp(1.7rem, 3.5vw, 2.5rem);
		letter-spacing: -0.03em;
		line-height: 1.2;
	}

	.description {
		margin: 0 0 1.25rem;
		font-size: 0.95rem;
		line-height: 1.65;
	}

	.read-link {
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.featured-card:hover .read-link,
	.article-card:hover .read-link {
		color: var(--accent-dark);
	}

	.featured-mark {
		color: rgb(var(--gray-light));
		font-size: clamp(4rem, 10vw, 8rem);
		font-weight: 700;
		letter-spacing: -0.08em;
		line-height: 1;
	}

	.archive-section {
		padding-top: clamp(3rem, 6vw, 5rem);
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.8rem, 3.6vw, 2.5rem);
		letter-spacing: -0.03em;
	}

	.section-heading > p {
		margin: 0 0 0.2rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.article-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-height: 100%;
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.8rem;
		background: #fff;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
	}

	.article-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		box-shadow: 0 10px 28px rgb(var(--black) / 8%);
		color: rgb(var(--gray-dark));
	}

	.article-card h3 {
		margin: 0 0 0.75rem;
		color: rgb(var(--black));
		font-size: 1.1rem;
		line-height: 1.4;
	}

	.article-card .description {
		font-size: 0.9rem;
	}

	.article-card .read-link {
		margin-top: auto;
	}

	@media (max-width: 900px) {
		.article-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.blog-page {
			width: min(100% - 1.5rem, 1060px);
		}

		.featured-section {
			padding: 1.25rem;
		}

		.featured-mark {
			display: none;
		}

		.article-grid {
			grid-template-columns: 1fr;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.article-card {
			transition: none;
		}
	}
</style>
