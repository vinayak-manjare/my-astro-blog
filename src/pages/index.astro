---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { BLOG_TOPICS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const today = new Date();
const posts = (await getCollection('blog'))
	.filter((post) => post.data.pubDate <= today)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = posts.slice(0, 3);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-page">
			<section class="hero" aria-labelledby="home-title">
				<div class="hero-copy">
					<p class="eyebrow">Architecture · Cloud · Applied AI</p>
					<h1 id="home-title">Engineering systems for real-world impact.</h1>
					<p class="hero-description">
						I’m Vinayak Manjare, a technical architect writing about enterprise software,
						procurement platforms, backend engineering, and practical AI.
					</p>
					<div class="actions">
						<a class="button button-primary" href={`${basePath}/blog`}>Explore the blog</a>
						<a class="button button-secondary" href={`${basePath}/about`}>About me</a>
					</div>
				</div>
				<aside class="hero-note">
					<p class="eyebrow">What I write about</p>
					<ul>
						<li>Modernizing enterprise and procurement systems</li>
						<li>Designing dependable cloud and backend platforms</li>
						<li>Applying AI to complex business workflows</li>
					</ul>
				</aside>
			</section>

			<section class="section" aria-labelledby="latest-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">From the blog</p>
						<h2 id="latest-title">Latest articles</h2>
					</div>
					<a class="text-link" href={`${basePath}/blog`}>View all articles <span aria-hidden="true">→</span></a>
				</div>
				{latestPosts.length > 0 ? (
					<div class="article-grid">
						{latestPosts.map((post) => (
							<a class="article-card" href={`${basePath}/blog/${post.id}/`}>
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								<h3>{post.data.title}</h3>
								<p class="description">{post.data.description}</p>
								<span class="card-link">Read article <span aria-hidden="true">→</span></span>
							</a>
						))}
					</div>
				) : (
					<p>No articles are published yet. Check back soon.</p>
				)}
			</section>

			<section class="topics-section" aria-labelledby="topics-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Explore by topic</p>
						<h2 id="topics-title">Ideas grounded in real systems</h2>
					</div>
				</div>
				<div class="topic-grid">
					{BLOG_TOPICS.map((topic, index) => (
						<a class="topic-card" href={`${basePath}/blog/#topic-${topic.id}`}>
							<span class="topic-number">{String(index + 1).padStart(2, '0')}</span>
							<h3>{topic.title}</h3>
							<p>{topic.description}</p>
							<span class="topic-link">Browse articles <span aria-hidden="true">→</span></span>
						</a>
					))}
				</div>
			</section>

			<section class="contact-panel" aria-labelledby="contact-title">
				<div>
					<p class="eyebrow">About the author</p>
					<h2 id="contact-title">Building dependable technology, one system at a time.</h2>
					<p>Read more about my experience, current focus, and the work behind this blog.</p>
				</div>
				<a class="button button-light" href={`${basePath}/about`}>Meet Vinayak <span aria-hidden="true">→</span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-page {
		width: min(100% - 2rem, 1060px);
		max-width: none;
		margin-inline: auto;
		padding: clamp(2.5rem, 6vw, 5rem) 0;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(240px, 0.75fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 5rem);
		padding: 0 0 clamp(3rem, 7vw, 5.5rem);
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 13ch;
		margin-bottom: 1rem;
		font-size: clamp(2.5rem, 5.5vw, 4.2rem);
		letter-spacing: -0.045em;
	}

	.hero-description {
		max-width: 62ch;
		color: rgb(var(--gray-dark));
		font-size: clamp(1.15rem, 2.2vw, 1.4rem);
		line-height: 1.55;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.8rem;
		padding: 0.65rem 1rem;
		border: 1px solid transparent;
		border-radius: 0.5rem;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
	}

	.button-primary {
		background: var(--accent);
		color: #fff;
	}

	.button-primary:hover {
		background: var(--accent-dark);
		color: #fff;
	}

	.button-secondary {
		border-color: rgb(var(--gray-light));
		background: #fff;
		color: rgb(var(--gray-dark));
	}

	.button-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.hero-note {
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 1rem;
		background: rgb(255 255 255 / 82%);
		box-shadow: 0 12px 36px rgb(var(--black) / 7%);
	}

	.hero-note ul {
		display: grid;
		gap: 1rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.hero-note li {
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.section,
	.topics-section {
		padding: clamp(2.5rem, 6vw, 4.5rem) 0;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-heading h2,
	.contact-panel h2 {
		margin: 0;
		font-size: clamp(1.8rem, 3.6vw, 2.5rem);
		letter-spacing: -0.03em;
	}

	.text-link,
	.card-link {
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	.text-link:hover,
	.card-link:hover {
		color: var(--accent-dark);
	}

	.article-grid,
	.topic-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.article-card,
	.topic-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-height: 100%;
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.8rem;
		background: #fff;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
	}

	.article-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		box-shadow: 0 10px 28px rgb(var(--black) / 8%);
		color: rgb(var(--gray-dark));
	}

	.article-card .date {
		margin: 0 0 0.75rem;
		color: rgb(var(--gray));
		font-size: 0.8rem;
	}

	.article-card h3,
	.topic-card h3 {
		margin: 0 0 0.75rem;
		color: rgb(var(--black));
		font-size: 1.15rem;
		line-height: 1.35;
	}

	.article-card .description,
	.topic-card p {
		margin: 0 0 1.25rem;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.article-card .card-link {
		margin-top: auto;
	}

	.topic-card {
		background: rgb(255 255 255 / 70%);
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
	}

	.topic-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		box-shadow: 0 10px 28px rgb(var(--black) / 8%);
		color: rgb(var(--gray-dark));
	}

	.topic-number {
		margin-bottom: 1.25rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.topic-link {
		margin-top: auto;
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.topic-card:hover .topic-link {
		color: var(--accent-dark);
	}

	.contact-panel {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border-radius: 1rem;
		background: rgb(var(--gray-dark));
		color: #fff;
	}

	.contact-panel .eyebrow {
		color: #aeb8ff;
	}

	.contact-panel h2 {
		max-width: 22ch;
		margin-bottom: 0.5rem;
		color: #fff;
	}

	.contact-panel p:last-child {
		max-width: 56ch;
		margin: 0;
		color: rgb(255 255 255 / 78%);
		font-size: 0.95rem;
	}

	.button-light {
		flex: 0 0 auto;
		background: #fff;
		color: rgb(var(--gray-dark));
	}

	.button-light:hover {
		background: #e9ebff;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 800px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.article-grid,
		.topic-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.home-page {
			width: min(100% - 1.5rem, 1060px);
		}

		.article-grid,
		.topic-grid {
			grid-template-columns: 1fr;
		}

		.section-heading,
		.contact-panel {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button,
		.article-card,
		.topic-card {
			transition: none;
		}
	}
</style>
