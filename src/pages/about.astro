---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const linkedInUrl = 'https://www.linkedin.com/in/vinayakmanjare/';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About Vinayak Manjare | Vinayak's Blog"
			description="Meet Vinayak Manjare, a Pune-based Senior Technical Architect working across enterprise systems, cloud platforms, and applied AI."
		/>
	</head>
	<body>
		<Header />
		<main class="about-page">
			<section class="intro" aria-labelledby="about-title">
				<div class="intro-copy">
					<p class="eyebrow">About</p>
					<h1 id="about-title">Hi, I’m Vinayak Manjare.</h1>
					<p class="lead">
						I’m a Senior Technical Architect based in Pune, with over 15 years of experience building
						and evolving enterprise systems across banking, procurement, and e-commerce.
					</p>
					<p>
						My work focuses on making complex systems dependable: modernizing legacy platforms,
						designing backend and cloud architecture, and bringing AI capabilities into production
						with a focus on reliability, security, and cost.
					</p>
					<div class="actions">
						<a class="button button-primary" href={`${basePath}/blog`}>Explore the blog</a>
						<a class="button button-secondary" href={linkedInUrl} target="_blank" rel="noreferrer">
							Connect on LinkedIn
						</a>
					</div>
				</div>
				<aside class="profile-card" aria-label="Profile highlights">
					<p class="eyebrow">At a glance</p>
					<dl>
						<div>
							<dt>Based in</dt>
							<dd>Pune, India</dd>
						</div>
						<div>
							<dt>Experience</dt>
							<dd>15+ years</dd>
						</div>
						<div>
							<dt>Focus</dt>
							<dd>Enterprise architecture &amp; applied AI</dd>
						</div>
					</dl>
				</aside>
			</section>

			<section class="section" aria-labelledby="journey-title">
				<div class="section-heading">
					<p class="eyebrow">Career</p>
					<h2 id="journey-title">Professional journey</h2>
					<p>Building products and platforms, from core procurement workflows to enterprise-scale systems.</p>
				</div>
				<ol class="timeline">
					<li class="timeline-item">
						<p class="timeline-date">2011–2018</p>
						<div>
							<h3>Product foundations <span>Yardi</span></h3>
							<p>Developed and designed procure-to-pay systems, building a foundation in enterprise products and business workflows.</p>
						</div>
					</li>
					<li class="timeline-item">
						<p class="timeline-date">2018–2022</p>
						<div>
							<h3>Enterprise scale <span>Charles Schwab · Deutsche Bank</span></h3>
							<p>Worked on identity platforms and high-velocity monitoring systems in large financial-services environments.</p>
						</div>
					</li>
					<li class="timeline-item">
						<p class="timeline-date">2023–Present</p>
						<div>
							<h3>AI innovation <span>Persistent</span></h3>
							<p>As a Project Lead, transforming legacy sourcing platforms into AI-enabled products and workflows.</p>
						</div>
					</li>
				</ol>
			</section>

			<section class="section" aria-labelledby="impact-title">
				<div class="section-heading">
					<p class="eyebrow">Outcomes</p>
					<h2 id="impact-title">Engineering with measurable impact</h2>
				</div>
				<div class="impact-grid">
					<article class="impact-card">
						<p class="metric">25%</p>
						<h3>Lower cloud costs</h3>
						<p>Reduced monthly AWS Fargate costs through strategic microservices refactoring.</p>
					</article>
					<article class="impact-card">
						<p class="metric">60%</p>
						<h3>Lower token costs</h3>
						<p>Cut LLM token consumption using custom metadata caching in AI workflows.</p>
					</article>
				</div>
			</section>

			<section class="section" aria-labelledby="expertise-title">
				<div class="section-heading">
					<p class="eyebrow">Expertise</p>
					<h2 id="expertise-title">Areas of focus</h2>
				</div>
				<div class="expertise-grid">
					<article class="expertise-card">
						<h3>Applied AI</h3>
						<p>RAG pipeline design, prompt engineering, metadata caching, and production-minded LLM integration.</p>
					</article>
					<article class="expertise-card">
						<h3>Backend engineering</h3>
						<p>Java 17, Spring Boot 3.2, microservices architecture, and platform consolidation.</p>
					</article>
					<article class="expertise-card">
						<h3>Cloud &amp; data</h3>
						<p>AWS Lambda, Fargate, and S3, alongside data streaming and enterprise integrations.</p>
					</article>
				</div>
			</section>

			<section class="section" aria-labelledby="certifications-title">
				<div class="section-heading">
					<p class="eyebrow">Credentials</p>
					<h2 id="certifications-title">Certifications</h2>
				</div>
				<div class="certification-grid">
					<a
						class="certification-card"
						href="https://www.credly.com/badges/4d4693bb-530e-4bca-9327-de07f3aa2348"
						target="_blank"
						rel="noreferrer"
					>
						<span class="certification-label">AWS</span>
						<span>
							<strong>AWS Certified AI Practitioner</strong>
							<span>AI/ML solutions, generative AI foundations, and responsible AI.</span>
						</span>
						<span class="external-link" aria-hidden="true">↗</span>
					</a>
					<a
						class="certification-card"
						href="https://www.credly.com/badges/4136ced8-75d5-4afb-8677-40b6236e2672"
						target="_blank"
						rel="noreferrer"
					>
						<span class="certification-label">Azure</span>
						<span>
							<strong>Microsoft Certified: Azure AI Fundamentals (AI-900)</strong>
							<span>Foundational knowledge of AI and machine learning workloads on Azure.</span>
						</span>
						<span class="external-link" aria-hidden="true">↗</span>
					</a>
				</div>
			</section>

			<section class="contact-panel" aria-labelledby="contact-title">
				<div>
					<p class="eyebrow">Get in touch</p>
					<h2 id="contact-title">Let’s connect.</h2>
					<p>I’m always glad to connect with people working on enterprise software, cloud systems, and applied AI.</p>
				</div>
				<a class="button button-light" href={linkedInUrl} target="_blank" rel="noreferrer">
					Find me on LinkedIn <span aria-hidden="true">↗</span>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		width: min(100% - 2rem, 960px);
		max-width: none;
		margin-inline: auto;
		padding: clamp(2.5rem, 6vw, 5rem) 0;
	}

	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(220px, 0.75fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 5rem);
		padding-bottom: clamp(3rem, 7vw, 5.5rem);
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.intro h1 {
		max-width: 13ch;
		margin-bottom: 1rem;
		font-size: clamp(2.4rem, 5.5vw, 4rem);
		letter-spacing: -0.045em;
	}

	.intro-copy > p:not(.eyebrow) {
		max-width: 62ch;
	}

	.intro .lead {
		color: rgb(var(--black));
		font-size: clamp(1.15rem, 2.2vw, 1.4rem);
		line-height: 1.5;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.8rem;
		padding: 0.65rem 1rem;
		border: 1px solid transparent;
		border-radius: 0.5rem;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
	}

	.button-primary {
		background: var(--accent);
		color: #fff;
	}

	.button-primary:hover {
		background: var(--accent-dark);
		color: #fff;
	}

	.button-secondary {
		border-color: rgb(var(--gray-light));
		background: #fff;
		color: rgb(var(--gray-dark));
	}

	.button-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.profile-card {
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 1rem;
		background: rgb(255 255 255 / 82%);
		box-shadow: 0 12px 36px rgb(var(--black) / 7%);
	}

	.profile-card dl {
		display: grid;
		gap: 1.1rem;
		margin: 1.25rem 0 0;
	}

	.profile-card dl div {
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.profile-card dt {
		color: rgb(var(--gray));
		font-size: 0.8rem;
	}

	.profile-card dd {
		margin: 0.2rem 0 0;
		color: rgb(var(--black));
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.45;
	}

	.section {
		padding: clamp(2.5rem, 6vw, 4.5rem) 0;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.section-heading {
		max-width: 650px;
		margin-bottom: 1.75rem;
	}

	.section-heading h2,
	.contact-panel h2 {
		margin-bottom: 0.5rem;
		font-size: clamp(1.8rem, 3.6vw, 2.5rem);
		letter-spacing: -0.03em;
	}

	.section-heading > p:last-child {
		margin: 0;
		color: rgb(var(--gray-dark));
	}

	.timeline {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.timeline-item {
		display: grid;
		grid-template-columns: 150px minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1.5rem 0;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.timeline-item:first-child {
		border-top: 0;
	}

	.timeline-date {
		margin: 0;
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.timeline-item h3,
	.impact-card h3,
	.expertise-card h3 {
		margin: 0 0 0.45rem;
		font-size: 1.1rem;
	}

	.timeline-item h3 span {
		display: block;
		margin-top: 0.25rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		font-weight: 400;
	}

	.timeline-item div p,
	.impact-card p:last-child,
	.expertise-card p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.65;
	}

	.impact-grid,
	.expertise-grid,
	.certification-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.impact-card,
	.expertise-card {
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.8rem;
		background: #fff;
	}

	.metric {
		margin: 0 0 0.4rem;
		color: var(--accent);
		font-size: 2.5rem;
		font-weight: 700;
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.expertise-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.expertise-card h3 {
		color: rgb(var(--black));
	}

	.certification-card {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: start;
		gap: 1rem;
		padding: 1.25rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.8rem;
		background: #fff;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: border-color 160ms ease, box-shadow 160ms ease;
	}

	.certification-card:hover {
		border-color: var(--accent);
		box-shadow: 0 8px 24px rgb(var(--black) / 8%);
		color: rgb(var(--gray-dark));
	}

	.certification-label {
		display: grid;
		width: 2.6rem;
		height: 2.6rem;
		place-items: center;
		border-radius: 0.6rem;
		background: rgb(var(--gray-light) / 55%);
		color: var(--accent-dark);
		font-size: 0.7rem;
		font-weight: 700;
	}

	.certification-card strong,
	.certification-card span span {
		display: block;
	}

	.certification-card strong {
		margin-bottom: 0.35rem;
		color: rgb(var(--black));
		font-size: 0.95rem;
		line-height: 1.4;
	}

	.certification-card span span {
		font-size: 0.85rem;
		line-height: 1.5;
	}

	.external-link {
		color: var(--accent);
		font-size: 1.1rem;
	}

	.contact-panel {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border-radius: 1rem;
		background: rgb(var(--gray-dark));
		color: #fff;
	}

	.contact-panel .eyebrow {
		color: #aeb8ff;
	}

	.contact-panel h2 {
		color: #fff;
	}

	.contact-panel p:last-child {
		max-width: 56ch;
		margin: 0;
		color: rgb(255 255 255 / 78%);
		font-size: 0.95rem;
	}

	.button-light {
		flex: 0 0 auto;
		background: #fff;
		color: rgb(var(--gray-dark));
	}

	.button-light:hover {
		background: #e9ebff;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 760px) {
		.intro {
			grid-template-columns: 1fr;
		}

		.profile-card {
			max-width: none;
		}

		.expertise-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.about-page {
			width: min(100% - 1.5rem, 960px);
		}

		.timeline-item {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}

		.impact-grid,
		.certification-grid {
			grid-template-columns: 1fr;
		}

		.contact-panel {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button,
		.certification-card {
			transition: none;
		}
	}
</style>
