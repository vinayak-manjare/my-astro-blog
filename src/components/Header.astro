---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
function withBase(path) {
	return `${basePath}${path}`;
}

 
---

<header>
	<nav>
		<h2><a href={withBase('/')}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={withBase('/')}>Home</HeaderLink>
			<HeaderLink href={withBase('/blog')}>Blog</HeaderLink>
			<HeaderLink href={withBase('/about')}>About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.linkedin.com/in/vinayakmanjare/" target="_blank">
				<span class="sr-only">Connect on LinkedIn</span>
				LinkedIn
			</a>
			<a href="https://github.com/vinap" target="_blank">
				<span class="sr-only">View GitHub</span>
				GitHub
			</a>
		</div>
	</nav>
	
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1rem;
		white-space: nowrap;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1200px;
		margin: 0 auto;
	}
	nav a {
		padding: 0.9em 0.55em;
		color: var(--black);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			gap: 0;
			padding-top: 0.25rem;
		}
		nav h2 {
			display: flex;
			flex: 1;
			align-items: center;
			min-height: 48px;
		}
		.internal-links {
			flex: 0 0 100%;
			width: 100%;
			border-top: 1px solid rgb(var(--gray-light));
		}
		nav a {
			padding: 0.6rem 0.8rem;
		}
		.social-links {
			display: none;
		}
	}
	.astro-details {
		margin-top: 1em;
		padding: 1em;
		background: #f5f5f5;
		border-left: 4px solid var(--accent);
	}
	.astro-details h3 {
		margin-top: 0;
	}
	.astro-details pre {
		margin: 0;
		overflow-x: auto;
		font-size: 0.85em;
	}
</style>


